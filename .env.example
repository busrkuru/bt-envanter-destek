DJANGO_SECRET_KEY=replace-this-with-a-long-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# Local development: keep HTTPS redirect off. For deployment, use HTTPS and set this to True.
DJANGO_SECURE_SSL_REDIRECT=False
# Set a positive HSTS duration only after the production domain serves HTTPS correctly.
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False
DJANGO_SECURE_HSTS_PRELOAD=False
# Comma-separated HTTPS origins if the production host/proxy requires them.
DJANGO_CSRF_TRUSTED_ORIGINS=
# Enable only behind a trusted proxy that sets X-Forwarded-Proto correctly.
DJANGO_SECURE_PROXY_SSL_HEADER=False
POSTGRES_DB=it_inventory
POSTGRES_USER=it_inventory
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
